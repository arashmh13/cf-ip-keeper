# ============================================================
# CF IP Keeper - configuration
# Copy this file to keeper.env and fill in YOUR values.
# keeper.env is gitignored - NEVER commit the real one.
# ============================================================

# Your PROXIED (orange-cloud) domain in Cloudflare.
# This is the SNI + Host header your VLESS client sends.
CF_DOMAIN=example.com

# Grey-cloud (DNS-only) A records this tool owns.
# These become the address= values in your VLESS client configs.
# Comma separated. Each record always gets a DIFFERENT relay IP.
CF_RECORDS=cn.example.com,cn2.example.com

# Cloudflare API token - permissions: Zone > DNS > Edit, one zone only.
# Create at: dash.cloudflare.com > My Profile > API Tokens
CF_TOKEN=your_api_token_here

# Cloudflare Zone ID - dashboard > your zone > Overview > right sidebar.
CF_ZONE_ID=your_zone_id_here

# Optional: URL to download ranges.txt from if missing (leave empty to skip).
RANGES_URL=
